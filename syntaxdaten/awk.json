"liste": [
 "--- Syntax items ---",
 "awkStatement   xxx return print @load delete printf continue break nextfile",
 "                   func exit default @namespace function switch @include case",
 "                   next getline",
 "                   links to Statement",
 "awkFunction    xxx and gensub sub strftime tolower asorti cos dcgettext srand",
 "                   gsub mktime patsplit toupper atan2 compl close",
 "                   bindtextdomain sin asort substr split index exp or log",
 "                   systime rshift fflush lshift sprintf dcngetext strtonum sqrt",
 "                   system int length match typeof rand xor isarray",
 "                   links to Function",
 "awkConditional xxx else if",
 "                   links to Conditional",
 "awkRepeat      xxx for while do",
 "                   links to Repeat",
 "awkTodo        xxx contained TODO",
 "                   links to Todo",
 "awkPatterns    xxx ENDFILE END BEGIN BEGINFILE",
 "                   links to Special",
 "awkVariables   xxx NF PREC TEXTDOMAIN RLENGTH BINMODE SUBSEP ROUNDMODE FNR",
 "                   IGNORECASE OFMT FUNCTAB LINT ORS ARGC RS RT FPAT ARGV",
 "                   ENVIRON FIELDWIDTHS CONVFMT NR PROCINFO ERRNO RSTART OFS",
 "                   FILENAME SYMTAB ARGIND FS",
 "                   links to Special",
 "awkOperator    xxx match #+\\|-\\|\\*\\|/\\|%\\|=#  ",
 "                   match #+=\\|-=\\|\\*=\\|/=\\|%=#  ",
 "                   match /\\^\\|\\^=/  ",
 "                   links to Special",
 "awkSpecialCharacter xxx match /\\\\[0-7]\\{1,3\\}/  display contained ",
 "                   match /\\\\x[0-9A-Fa-f]\\+/  display contained ",
 "                   match /\\\\./  contained ",
 "                   links to Special",
 "awkFieldVars   xxx match /\\$\\d\\+/  ",
 "                   links to Special",
 "awkParenError  xxx match /)/  display ",
 "                   links to awkError",
 "awkArrayElement xxx match /[^][, \\t]\\+/  contained ",
 "                   links to Special",
 "awkArrayArray  xxx match /[^][, \\t]\\+\\[/me=e-1  contained ",
 "                   links to awkArray",
 "awkRegExp      xxx match +/\\^+ms=s+1  contained ",
 "                   match +\\$/+me=e-1  contained ",
 "                   match /[?.*{}|+]/  contained ",
 "                   links to Special",
 "awkBrktRegExp  xxx match /\\\\.\\|.\\-[^]]/  contained ",
 "                   links to awkNestRegExp",
 "awkBrackets    xxx start=/\\[[^\\^]/ms=s+1 start=/\\[\\^\\]\\=/ms=s+2 end=/\\]/me=e-1  contained contains=awkBrktRegExp,awkCharClass ",
 "                   links to awkRegExp",
 "awkCharClass   xxx match /\\[:[^:\\]]*:\\]/  contained ",
 "                   links to awkNestRegExp",
 "awkParen       xxx start=/(/ end=/)/  transparent contains=ALLBUT,awkParenError,awkSpecialCharacter,awkArrayElement,awkArrayArray,awkTodo,awkRegExp,awkBrktRegExp,awkBrackets,awkCharClass ",
 "awkSearch      xxx start=+\\(,\\|!\\=\\~\\)[ \\t]*/+ms=e start=+^[ \\t]*/+ms=e skip=+\\\\\\\\\\|\\\\/+ end=+/+  oneline contains=awkBrackets,awkRegExp,awkSpecialCharacter ",
 "                   start=+[ \\t]*/+hs=e skip=+\\\\\\\\\\|\\\\/+ end=+/+  oneline contains=awkBrackets,awkRegExp,awkSpecialCharacter ",
 "                   links to String",
 "awkSpecialPrintf xxx match /%[-+ #]*\\d*\\.\\=\\d*[cdefgiosuxEGX%]/  contained ",
 "                   links to Special",
 "awkString      xxx start=/\"/ skip=/\\\\\\\\\\|\\\\\"/ end=/\"/  contains=@Spell,awkSpecialCharacter,awkSpecialPrintf ",
 "                   links to String",
 "awkNumber      xxx match /[+-]\\=\\<\\d\\+\\>/  display ",
 "                   links to Number",
 "awkFloat       xxx match /[+-]\\=\\<\\d\\+\\.\\d+\\>/  display ",
 "                   match /[+-]\\=\\<.\\d+\\>/  display ",
 "                   match /\\<\\d\\+\\.\\d*\\(e[-+]\\=\\d\\+\\)\\=\\>/  display ",
 "                   match /\\.\\d\\+\\(e[-+]\\=\\d\\+\\)\\=\\>/  display ",
 "                   match /\\<\\d\\+e[-+]\\=\\d\\+\\>/  display ",
 "                   links to Float",
 "awkExpression  xxx in",
 "                   match /==\\|>=\\|=>\\|<=\\|=<\\|\\!=/  ",
 "                   match /\\~\\|\\!\\~/  ",
 "                   match /?\\|:/  ",
 "                   links to Special",
 "awkBoolLogic   xxx match /||\\|&&\\|\\!/  ",
 "                   links to Special",
 "awkSemicolon   xxx match /;/  ",
 "                   links to Special",
 "awkComma       xxx match /,/  ",
 "                   links to Special",
 "awkComment     xxx match /#.*/  contains=@Spell,awkTodo ",
 "                   links to Comment",
 "awkLineSkip    xxx match /\\\\$/  ",
 "                   links to Special",
 "awkArray       xxx start=/\\[/ end=/\\]/  transparent contains=awkArray,awkArrayElement,awkArrayArray,awkNumber,awkFloat ",
 "Spell          cluster=NONE"
]
