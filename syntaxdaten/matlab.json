"liste": [
 "--- Syntax items ---",
 "matlabStatement xxx return",
 "                   links to Statement",
 "matlabLabel    xxx case switch",
 "                   links to Label",
 "matlabConditional xxx else end otherwise if elseif",
 "                   links to Conditional",
 "matlabRepeat   xxx for while do",
 "                   links to Repeat",
 "matlabExceptions xxx catch try",
 "                   links to Conditional",
 "matlabOO       xxx methods properties events classdef",
 "                   links to Statement",
 "matlabTodo     xxx contained TODO",
 "                   links to Todo",
 "matlabScope    xxx persistent global",
 "                   links to Type",
 "matlabArithmeticOperator xxx match /[-+]/  ",
 "                   match +\\.\\=[*/\\\\^]+  ",
 "                   links to matlabOperator",
 "matlabRelationalOperator xxx match /[=~]=/  ",
 "                   match /[<>]=\\=/  ",
 "                   links to matlabOperator",
 "matlabLogicalOperator xxx match /[&|~]/  ",
 "                   links to matlabOperator",
 "matlabLineContinuation xxx match /\\.\\{3}/  ",
 "                   links to Special",
 "matlabString   xxx start=/'/ skip=/''/ end=/'/  oneline ",
 "                   links to String",
 "matlabStringArray xxx start=/\"/ skip=/\"\"/ end=/\"/  oneline ",
 "                   links to String",
 "matlabTab      xxx match /\\t/  ",
 "matlabNumber   xxx match /\\<\\d\\+[ij]\\=\\>/  ",
 "                   links to Number",
 "matlabFloat    xxx match /\\<\\d\\+\\(\\.\\d*\\)\\=\\([edED][-+]\\=\\d\\+\\)\\=[ij]\\=\\>/  ",
 "                   match /\\.\\d\\+\\([edED][-+]\\=\\d\\+\\)\\=[ij]\\=\\>/  ",
 "                   links to Float",
 "matlabDelimiter xxx match /[][]/  ",
 "                   links to Identifier",
 "matlabTransposeOperator xxx match /[])a-zA-Z0-9.]'/ms=s+1,lc=1  ",
 "                   links to matlabOperator",
 "matlabSemicolon xxx match /;/  ",
 "                   links to SpecialChar",
 "matlabComment  xxx match /%.*$/  contains=matlabTodo,matlabTab ",
 "                   match /\\.\\.\\..*$/  contains=matlabTodo,matlabTab ",
 "                   links to Comment",
 "matlabMultilineComment xxx start=/%{/ end=/%}/  contains=matlabTodo,matlabTab ",
 "                   links to Comment",
 "matlabCellComment xxx match /^%%.*$/  ",
 "                   links to Todo",
 "matlabOperator xxx size mean cov ceil margin round break default floor ones std",
 "                   zeros zeros eye clear rand",
 "                   links to Operator",
 "matlabFunction xxx function eval error",
 "                   links to Function",
 "matlabImplicit xxx abs tan sum max min exp sqrt prod atan log10 cosh sign sin",
 "                   reshape acos sinh log asin cos",
 "                   links to matlabStatement",
 "matlabError    xxx match #-\\=\\<\\d\\+\\.\\d\\+\\.[^*/\\\\^]#  ",
 "                   match #-\\=\\<\\d\\+\\.\\d\\+[eEdD][-+]\\=\\d\\+\\.\\([^*/\\\\^]\\)#  ",
 "                   links to Error"
]
