"liste": [
 "--- Syntax items ---",
 "mojoStatement  xxx return None",
 "                   nextgroup=mojoFunction  skipwhite fn",
 "                   False True var lambda",
 "                   nextgroup=mojoFunction  skipwhite def",
 "                   del alias",
 "                   nextgroup=mojoFunction  skipwhite class",
 "                   global nonlocal",
 "                   nextgroup=mojoFunction  skipwhite struct",
 "                   as yield with continue break pass assert let",
 "                   links to Statement",
 "mojoFunction   xxx match /\\h\\w*/  display contained ",
 "                   links to Function",
 "mojoConditional xxx if else elif",
 "                   match /^\\s*\\zscase\\%(\\s\\+.*:.*$\\)\\@=/  ",
 "                   match /^\\s*\\zsmatch\\%(\\s\\+.*:\\s*\\%(#.*\\)\\=$\\)\\@=/  ",
 "                   links to Conditional",
 "mojoRepeat     xxx for while",
 "                   links to Repeat",
 "mojoOperator   xxx or in is and not",
 "                   links to Operator",
 "mojoException  xxx finally raise except try",
 "                   links to Exception",
 "mojoInclude    xxx from import",
 "                   links to Include",
 "mojoAsync      xxx async await",
 "                   links to Statement",
 "mojoDecorator  xxx match /@/  display contained ",
 "                   links to Define",
 "mojoDecoratorName xxx match /@\\s*\\h\\%(\\w\\|\\.\\)*/  display contains=pythonDecorator ",
 "                   links to Function",
 "mojoDoctestValue xxx start=/^\\s*\\%(>>>\\s\\|\\.\\.\\.\\s\\|\"\"\"\\|'''\\)\\@!\\S\\+/ end=/$/  contained ",
 "                   links to Define",
 "mojoMatrixMultiply xxx match /\\%(\\w\\|[])]\\)\\s*@/  transparent contains=ALLBUT,mojoDecoratorName,mojoDecorator,mojoFunction,mojoDoctestValue ",
 "                   match /[^\\\\]\\\\\\s*\\n\\%(\\s*\\.\\.\\.\\s\\)\\=\\s\\+@/  transparent contains=ALLBUT,mojoDecoratorName,mojoDecorator,mojoFunction,mojoDoctestValue ",
 "                   match /^\\s*\\%(\\%(>>>\\|\\.\\.\\.\\)\\s\\+\\)\\=\\zs\\%(\\h\\|\\%(\\h\\|[[(]\\).\\{-}\\%(\\w\\|[])]\\)\\)\\s*\\n\\%(\\s*\\.\\.\\.\\s\\)\\=\\s\\+@\\%(.\\{-}\\n\\%(\\s*\\.\\.\\.\\s\\)\\=\\s\\+@\\)*/  transparent contains=ALLBUT,mojoDecoratorName,mojoDecorator,mojoFunction,mojoDoctestValue ",
 "mojoTodo       xxx contained NOTE XXX TODO NOTES FIXME",
 "                   links to Todo",
 "mojoComment    xxx match /#.*$/  contains=mojoTodo,@Spell ",
 "                   links to Comment",
 "mojoEscape     xxx match /\\\\[abfnrtv'\"\\\\]/  contained ",
 "                   match /\\\\\\o\\{1,3}/  contained ",
 "                   match /\\\\x\\x\\{2}/  contained ",
 "                   match /\\%(\\\\u\\x\\{4}\\|\\\\U\\x\\{8}\\)/  contained ",
 "                   match /\\\\N{\\a\\+\\%(\\s\\a\\+\\)*}/  contained ",
 "                   match /\\\\$/  ",
 "                   links to Special",
 "mojoString     xxx matchgroup=mojoQuotes start=/[uU]\\=\\z(['\"]\\)/ skip=/\\\\\\\\\\|\\\\\\z1/ end=/\\z1/  contains=mojoEscape,@Spell ",
 "                   matchgroup=mojoTripleQuotes start=/[uU]\\=\\z('''\\|\"\"\"\\)/ end=/\\z1/  keepend contains=mojoEscape,mojoSpaceError,mojoDoctest,@Spell ",
 "                   links to String",
 "mojoDoctest    xxx start=/^\\s*>>>\\s/ end=/^\\s*$/  contained contains=ALLBUT,mojoDoctest,mojoFunction,@Spell ",
 "                   links to Special",
 "mojoRawString  xxx matchgroup=mojoQuotes start=/[uU]\\=[rR]\\z(['\"]\\)/ skip=/\\\\\\\\\\|\\\\\\z1/ end=/\\z1/  contains=@Spell ",
 "                   matchgroup=pythonTripleQuotes start=/[uU]\\=[rR]\\z('''\\|\"\"\"\\)/ end=/\\z1/  keepend contains=pythonSpaceError,mojoDoctest,@Spell ",
 "                   links to String",
 "mojoNumber     xxx match /\\<0[oO]\\%(_\\=\\o\\)\\+\\>/  ",
 "                   match /\\<0[xX]\\%(_\\=\\x\\)\\+\\>/  ",
 "                   match /\\<0[bB]\\%(_\\=[01]\\)\\+\\>/  ",
 "                   match /\\<\\%([1-9]\\%(_\\=\\d\\)*\\|0\\+\\%(_\\=0\\)*\\)\\>/  ",
 "                   match /\\<\\d\\%(_\\=\\d\\)*[jJ]\\>/  ",
 "                   match /\\<\\d\\%(_\\=\\d\\)*[eE][+-]\\=\\d\\%(_\\=\\d\\)*[jJ]\\=\\>/  ",
 "                   match /\\<\\d\\%(_\\=\\d\\)*\\.\\%([eE][+-]\\=\\d\\%(_\\=\\d\\)*\\)\\=[jJ]\\=\\%(\\W\\|$\\)\\@=/  ",
 "                   match /\\%(^\\|\\W\\)\\zs\\%(\\d\\%(_\\=\\d\\)*\\)\\=\\.\\d\\%(_\\=\\d\\)*\\%([eE][+-]\\=\\d\\%(_\\=\\d\\)*\\)\\=[jJ]\\=\\>/  ",
 "                   links to Number",
 "mojoBuiltin    xxx isdigit string index debug_assert ord slice range rebind",
 "                   atol put_new_line address chr print_no_newline print",
 "                   constrained len element_type",
 "                   links to Function",
 "mojoType       xxx f16 si64 ui32 bf16 si8 AnyType Byte None Attr",
 "                   CoroutineContext ListLiteral si16 unit8 Int uint64 float64",
 "                   Tuple f32 UInt32 NoneType invalid Int64 int16 ui64 bfloat16",
 "                   type unit16 StringLiteral int8 Float16 DType String Lifetime",
 "                   int32 f64 Int8 UInt16 SIMD Float32 Error float16 si32 UInt8",
 "                   Int16 int64 ui16 bool dtype StringRef Coroutine FloatLiteral",
 "                   uint32 float32 Float64 _65x13_type ui8 Int32 element_type",
 "                   UInt64",
 "                   links to Type",
 "mojoAttribute  xxx match /\\.\\h\\w*/hs=s+1  transparent contains=ALLBUT,mojoBuiltin,mojoFunction,mojoAsync ",
 "mojoExceptions xxx OSError MemoryError IsADirectoryError UserWarning NameError",
 "                   ArithmeticError NotImplementedError ConnectionAbortedError",
 "                   ReferenceError BaseException PermissionError LookupError",
 "                   ModuleNotFoundError OverflowError SystemExit",
 "                   IndentationError GeneratorExit ChildProcessError Warning",
 "                   RuntimeError EnvironmentError WindowsError AssertionError",
 "                   UnicodeWarning KeyError TypeError TabError BlockingIOError",
 "                   ImportError SyntaxWarning SyntaxError UnboundLocalError",
 "                   KeyboardInterrupt UnicodeDecodeError BrokenPipeError IOError",
 "                   Exception FutureWarning InterruptedError FileExistsError",
 "                   AttributeError UnicodeTranslateError EOFError",
 "                   FloatingPointError ValueError IndexError FileNotFoundError",
 "                   ConnectionRefusedError RuntimeWarning DeprecationWarning",
 "                   ResourceWarning NotADirectoryError PendingDeprecationWarning",
 "                   SystemError RecursionError StopAsyncIteration",
 "                   UnicodeEncodeError ImportWarning StopIteration",
 "                   ProcessLookupError UnicodeError BytesWarning TimeoutError",
 "                   ConnectionResetError ZeroDivisionError ConnectionError",
 "                   BufferError",
 "                   links to Structure",
 "Spell          cluster=NONE"
]
