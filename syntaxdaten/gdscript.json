"liste": [
 "--- Syntax items ---",
 "gdscriptConditional xxx else elif if match",
 "                   links to Conditional",
 "gdscriptRepeat xxx continue break for while",
 "                   links to Repeat",
 "gdscriptOperator xxx and or not as in is",
 "                   links to Operator",
 "gdscriptBlockStart xxx match /:\\s*$/  ",
 "                   links to Special",
 "gdscriptKeyword xxx owner self tool null parent",
 "                   links to Keyword",
 "gdscriptBoolean xxx true false",
 "                   links to Boolean",
 "gdscriptStatement xxx onready return puppet static breakpoint",
 "                   nextgroup=gdscriptTypeDecl  skipwhite const",
 "                   const",
 "                   nextgroup=gdscriptFunctionName  skipwhite signal",
 "                   pass master",
 "                   nextgroup=gdscriptExportTypeDecl  skipwhite export",
 "                   nextgroup=gdscriptFunctionName  skipwhite class",
 "                   puppetsync",
 "                   nextgroup=gdscriptFunctionName  skipwhite func",
 "                   class_name remote",
 "                   nextgroup=gdscriptSetGet,gdscriptSetGetSeparator  skipwhite setget",
 "                   nextgroup=gdscriptTypeDecl  skipwhite var",
 "                   enum mastersync assert sync remotesync extends",
 "                   links to Statement",
 "gdscriptType   xxx contained float int void bool String",
 "                   match /:\\s*\\zs\\h\\w*/  contained ",
 "                   match /->\\s*\\zs\\h\\w*/  contained ",
 "                   links to Type",
 "gdscriptTypeDecl xxx match /\\h\\w*\\s*:\\s*\\h\\w*/  contained contains=gdscriptType ",
 "                   match /->\\s*\\h\\w*/  contains=gdscriptType ",
 "gdscriptExportTypeDecl xxx match /(.\\{-}[,)]/  contained contains=gdscriptOperator,gdscriptType ",
 "gdscriptSetGet xxx match /\\h\\w*/  display contained nextgroup=gdscriptSetGetSeparator skipwhite ",
 "                   links to Function",
 "gdscriptSetGetSeparator xxx match /,/  display contained nextgroup=gdscriptSetGet skipwhite ",
 "gdscriptFunctionName xxx match /\\h\\w*/  display contained nextgroup=gdscriptFunctionParams skipwhite ",
 "                   links to Function",
 "gdscriptFunctionParams xxx match /(.*)/  display contained contains=gdscriptTypeDecl ",
 "gdscriptNode   xxx match +\\$\\h\\w*\\%(/\\h\\w*\\)*+  ",
 "                   links to PreProc",
 "gdscriptTodo   xxx contained NOTE FIXME TODO XXX BUG HACK",
 "                   links to Todo",
 "gdscriptComment xxx match /#.*$/  contains=@Spell,gdscriptTodo ",
 "                   links to Comment",
 "gdscriptEscape xxx match /\\\\[abfnrtv'\"\\\\]/  contained ",
 "                   match /\\\\$/  ",
 "                   links to Special",
 "gdscriptString xxx matchgroup=gdscriptQuotes start=/[uU]\\=\\z(['\"]\\)/ skip=/\\\\\\\\\\|\\\\\\z1/ end=/\\z1/  contains=gdscriptEscape,@Spell ",
 "                   matchgroup=gdscriptTripleQuotes start=/[uU]\\=\\z('''\\|\"\"\"\\)/ end=/\\z1/  keepend contains=gdscriptEscape,@Spell ",
 "                   links to String",
 "gdscriptNumber xxx match /\\<0x\\%(_\\=\\x\\)\\+\\>/  ",
 "                   match /\\<0b\\%(_\\=[01]\\)\\+\\>/  ",
 "                   match /\\<\\d\\%(_\\=\\d\\)*\\>/  ",
 "                   match /\\<\\d\\%(_\\=\\d\\)*\\%(e[+-]\\=\\d\\%(_\\=\\d\\)*\\)\\=\\>/  ",
 "                   match /\\<\\d\\%(_\\=\\d\\)*\\.\\%(e[+-]\\=\\d\\%(_\\=\\d\\)*\\)\\=\\%(\\W\\|$\\)\\@=/  ",
 "                   match /\\%(^\\|\\W\\)\\@1<=\\%(\\d\\%(_\\=\\d\\)*\\)\\=\\.\\d\\%(_\\=\\d\\)*\\%(e[+-]\\=\\d\\%(_\\=\\d\\)*\\)\\=\\>/  ",
 "                   links to Number",
 "Spell          cluster=NONE"
]
