"befehle": [
 ["syntax/gdscript.vim:14","sync maxlines=100"],
 ["syntax/gdscript.vim:16","keyword gdscriptConditional if else elif match"],
 ["syntax/gdscript.vim:17","keyword gdscriptRepeat for while break continue"],
 ["syntax/gdscript.vim:19","keyword gdscriptOperator is as not and or in"],
 ["syntax/gdscript.vim:21","match gdscriptBlockStart \":\\s*$\""],
 ["syntax/gdscript.vim:23","keyword gdscriptKeyword null self owner parent tool"],
 ["syntax/gdscript.vim:24","keyword gdscriptBoolean false true"],
 ["syntax/gdscript.vim:26","keyword gdscriptStatement remote master puppet remotesync mastersync puppetsync sync"],
 ["syntax/gdscript.vim:27","keyword gdscriptStatement return pass"],
 ["syntax/gdscript.vim:28","keyword gdscriptStatement static const enum"],
 ["syntax/gdscript.vim:29","keyword gdscriptStatement breakpoint assert"],
 ["syntax/gdscript.vim:30","keyword gdscriptStatement onready"],
 ["syntax/gdscript.vim:31","keyword gdscriptStatement class_name extends"],
 ["syntax/gdscript.vim:33","keyword gdscriptType void bool int float String contained"],
 ["syntax/gdscript.vim:34","match gdscriptType \":\\s*\\zs\\h\\w*\" contained"],
 ["syntax/gdscript.vim:35","match gdscriptType \"->\\s*\\zs\\h\\w*\" contained"],
 ["syntax/gdscript.vim:37","keyword gdscriptStatement var nextgroup=gdscriptTypeDecl skipwhite"],
 ["syntax/gdscript.vim:38","keyword gdscriptStatement const nextgroup=gdscriptTypeDecl skipwhite"],
 ["syntax/gdscript.vim:39","match gdscriptTypeDecl \"\\h\\w*\\s*:\\s*\\h\\w*\" contains=gdscriptType contained skipwhite"],
 ["syntax/gdscript.vim:40","match gdscriptTypeDecl \"->\\s*\\h\\w*\" contains=gdscriptType skipwhite"],
 ["syntax/gdscript.vim:42","keyword gdscriptStatement export nextgroup=gdscriptExportTypeDecl skipwhite"],
 ["syntax/gdscript.vim:43","match gdscriptExportTypeDecl \"(.\\{-}[,)]\" contains=gdscriptOperator,gdscriptType contained skipwhite"],
 ["syntax/gdscript.vim:45","keyword gdscriptStatement setget nextgroup=gdscriptSetGet,gdscriptSetGetSeparator skipwhite"],
 ["syntax/gdscript.vim:46","match gdscriptSetGet \"\\h\\w*\" nextgroup=gdscriptSetGetSeparator display contained skipwhite"],
 ["syntax/gdscript.vim:47","match gdscriptSetGetSeparator \",\" nextgroup=gdscriptSetGet display contained skipwhite"],
 ["syntax/gdscript.vim:49","keyword gdscriptStatement class func signal nextgroup=gdscriptFunctionName skipwhite"],
 ["syntax/gdscript.vim:50","match gdscriptFunctionName \"\\h\\w*\" nextgroup=gdscriptFunctionParams display contained skipwhite"],
 ["syntax/gdscript.vim:51","match gdscriptFunctionParams \"(.*)\" contains=gdscriptTypeDecl display contained skipwhite"],
 ["syntax/gdscript.vim:53","match gdscriptNode \"\\$\\h\\w*\\%(/\\h\\w*\\)*\""],
 ["syntax/gdscript.vim:55","match gdscriptComment \"#.*$\" contains=@Spell,gdscriptTodo"],
 ["syntax/gdscript.vim:57","region gdscriptString matchgroup=gdscriptQuotes start=+[uU]\\=\\z(['\"]\\)+ end=\"\\z1\" skip=\"\\\\\\\\\\|\\\\\\z1\" contains=gdscriptEscape,@Spell"],
 ["syntax/gdscript.vim:61","region gdscriptString matchgroup=gdscriptTripleQuotes start=+[uU]\\=\\z('''\\|\"\"\"\\)+ end=\"\\z1\" keepend contains=gdscriptEscape,@Spell"],
 ["syntax/gdscript.vim:65","match gdscriptEscape +\\\\[abfnrtv'\"\\\\]+ contained"],
 ["syntax/gdscript.vim:66","match gdscriptEscape \"\\\\$\""],
 ["syntax/gdscript.vim:69","match gdscriptNumber \"\\<0x\\%(_\\=\\x\\)\\+\\>\""],
 ["syntax/gdscript.vim:70","match gdscriptNumber \"\\<0b\\%(_\\=[01]\\)\\+\\>\""],
 ["syntax/gdscript.vim:71","match gdscriptNumber \"\\<\\d\\%(_\\=\\d\\)*\\>\""],
