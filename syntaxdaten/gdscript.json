 ["syntax/gdscript.vim:74","match gdscriptNumber \"\\%(^\\|\\W\\)\\@1<=\\%(\\d\\%(_\\=\\d\\)*\\)\\=\\.\\d\\%(_\\=\\d\\)*\\%(e[+-]\\=\\d\\%(_\\=\\d\\)*\\)\\=\\>\""],
