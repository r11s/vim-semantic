"liste": [
 "--- Syntax items ---",
 "ps1CDocParam   xxx match /.*/  contained ",
 "                   links to Identifier",
 "ps1CommentTodo xxx contained todo tbd hack xxx fixme note",
 "                   links to Todo",
 "ps1CommentDoc  xxx match /^\\s*\\zs\\.\\w\\+\\>/  contained nextgroup=ps1CDocParam ",
 "                   match /#\\s*\\zs\\.\\w\\+\\>/  contained nextgroup=ps1CDocParam ",
 "                   links to Tag",
 "ps1Comment     xxx match /#.*/  contains=ps1CommentTodo,ps1CommentDoc,@Spell ",
 "                   start=/<#/ end=/#>/  contains=ps1CommentTodo,ps1CommentDoc,@Spell ",
 "                   links to Comment",
 "ps1Conditional xxx else default switch if elseif",
 "                   links to Conditional",
 "ps1Repeat      xxx foreach continue break for until while in do",
 "                   match /\\<foreach\\>/  nextgroup=ps1Block skipwhite ",
 "                   links to Repeat",
 "ps1Block       xxx start=/{/ end=/}/  transparent fold ",
 "                   links to Block",
 "ps1Keyword     xxx nextgroup=ps1Function  skipwhite filter",
 "                   filter return param finally",
 "                   nextgroup=ps1Function  skipwhite workflow",
 "                   from",
 "                   nextgroup=ps1Function  skipwhite class",
 "                   class trap catch",
 "                   nextgroup=ps1Function  skipwhite function",
 "                   define",
 "                   nextgroup=ps1Function  skipwhite configuration",
 "                   data var",
 "                   nextgroup=ps1Function  skipwhite enum",
 "                   dynamicparam try in using throw",
 "                   match /\\<while\\>/  nextgroup=ps1Block skipwhite ",
 "                   match /\\<where\\>/  nextgroup=ps1Block skipwhite ",
 "                   links to Keyword",
 "ps1Exception   xxx parallel begin end exit inlinescript process sequence",
 "                   links to Exception",
 "ps1Constant    xxx $true $null $false",
 "                   match /\\$?/  ",
 "                   match /\\$_/  ",
 "                   match /\\$\\$/  ",
 "                   match /\\$^/  ",
 "                   match /\\$null\\>/  ",
 "                   links to Constant",
 "ps1Function    xxx match /\\w\\+\\(-\\w\\+\\)\\+/  contains=ps1Cmdlet ",
 "                   links to Identifier",
 "ps1Cmdlet      xxx match /\\v(add|clear|close|copy|enter|exit|find|format|get|hide|join|lock|move|new|open|optimize|pop|push|redo|remove|rename|reset|search|select|Set|show|skip|split|step|switch|undo|unlock|watch)(-\\w+)+/  contained ",
 "                   match /\\v(connect|disconnect|read|receive|send|write)(-\\w+)+/  contained ",
 "                   match /\\v(backup|checkpoint|compare|compress|convert|convertfrom|convertto|dismount|edit|expand|export|group|import|initialize|limit|merge|mount|out|publish|restore|save|sync|unpublish|update)(-\\w+)+/  contained ",
 "                   match /\\v(debug|measure|ping|repair|resolve|test|trace)(-\\w+)+/  contained ",
 "                   match /\\v(approve|assert|build|complete|confirm|deny|deploy|disable|enable|install|invoke|register|request|restart|resume|start|stop|submit|suspend|uninstall|unregister|wait)(-\\w+)+/  contained ",
 "                   match /\\v(block|grant|protect|revoke|unblock|unprotect)(-\\w+)+/  contained ",
 "                   match /\\v(use)(-\\w+)+/  contained ",
 "                   links to Function",
 "ps1Type        xxx match /\\[[a-z_][a-z0-9_.,\\[\\]]\\+\\]/  ",
 "                   links to Type",
 "ps1ScopeModifier xxx match /\\(global:\\|local:\\|private:\\|script:\\)/  contained ",
 "                   links to StorageClass",
 "ps1Variable    xxx match /\\$\\w\\+\\(:\\w\\+\\)\\?/  contains=ps1ScopeModifier ",
 "                   match /\\${\\w\\+\\(:\\?[[:alnum:]_()]\\+\\)\\?}/  contains=ps1ScopeModifier ",
 "                   links to Identifier",
 "ps1Operator    xxx -in -is -contains -replace -inotmatch -not -ccontains -le -f",
 "                   -split -ge -as -notmatch -lt -like -gt -or -cne -join -ilike",
 "                   -csplit -xor -imatch -cnotlike -notlike -cgt -ine -icontains",
 "                   -bxor -eq -ile -notin -cle -cge -isnot -clike -clt -match",
 "                   -and -cnotcontains -ireplace -ilt -igt -band -cnotmatch -ige",
 "                   -ceq -inotlike -notcontains -cmatch -inotcontains -ieq -bor",
 "                   -isplit -ne -bnot -creplace",
 "                   match /!/  ",
 "                   match /=/  ",
 "                   match /+=/  ",
 "                   match /-=/  ",
 "                   match /\\*=/  ",
 "                   match +\\/=+  ",
 "                   match /%=/  ",
 "                   match /+/  ",
 "                   match /-\\(\\s\\|\\d\\|\\.\\|\\$\\|(\\)\\@=/  ",
 "                   match /\\*/  ",
 "                   match +\\/+  ",
 "                   match /|/  ",
 "                   match /%/  ",
 "                   match /&/  ",
 "                   match /::/  ",
 "                   match /,/  ",
 "                   match /\\(^\\|\\s\\)\\@<=\\. \\@=/  ",
 "                   links to Operator",
 "ps1String      xxx start=/\"/ skip=/`\"/ end=/\"/  contains=@ps1StringSpecial,@Spell ",
 "                   start=/'/ skip=/''/ end=/'/  ",
 "                   start=/@\"$/ end=/^\"@/  contains=@ps1StringSpecial,@Spell ",
 "                   start=/@'$/ end=/^'@/  ",
 "                   links to String",
 "ps1Escape      xxx match /`./  ",
 "                   links to SpecialChar",
 "ps1Interpolation xxx matchgroup=ps1InterpolationDelimiter start=/$(/ end=/)/  contained contains=ALLBUT,@ps1NotTop ",
 "ps1NestedParentheses xxx start=/(/ skip=/\\\\\\\\\\|\\\\)/ matchgroup=ps1Interpolation end=/)/  contained transparent ",
 "ps1Boolean     xxx match /$\\%(true\\|false\\)\\>/  ",
 "                   links to Boolean",
 "ps1BuiltIn     xxx match /$^\\|$?\\|$_\\|$\\$/  ",
 "                   match /$\\%(args\\|error\\|foreach\\|home\\|input\\)\\>/  ",
 "                   match /$\\%(match\\(es\\)\\?\\|myinvocation\\|host\\|lastexitcode\\)\\>/  ",
 "                   match /$\\%(ofs\\|shellid\\|stacktrace\\)\\>/  ",
 "                   links to StorageClass",
 "ps1Number      xxx match /\\(\\<\\|-\\)\\@<=\\(0[xX]\\x\\+\\|\\d\\+\\)\\([KMGTP][B]\\)\\=\\(\\>\\|-\\)\\@=/  ",
 "                   match /\\(\\(\\<\\|-\\)\\@<=\\d\\+\\.\\d*\\|\\.\\d\\+\\)\\([eE][-+]\\=\\d\\+\\)\\=[dD]\\=/  ",
 "                   match /\\<\\d\\+[eE][-+]\\=\\d\\+[dD]\\=\\>/  ",
 "                   match /\\<\\d\\+\\([eE][-+]\\=\\d\\+\\)\\=[dD]\\>/  ",
 "                   links to Number",
 "ps1Label       xxx match /\\s-\\w\\+/  ",
 "                   links to Label",
 "ps1Region      xxx start=/#region/ end=/#endregion/  keepend extend transparent fold ",
 "                   links to Region",
 "ps1Signature   xxx start=/# SIG # Begin signature block/ end=/# SIG # End signature block/  transparent fold ",
 "ps1NotTop      cluster=@ps1Comment,ps1CDocParam,ps1FunctionDeclaration ",
 "ps1Comment     cluster=NONE",
 "Spell          cluster=NONE",
 "ps1StringSpecial cluster=ps1Escape,ps1Interpolation,ps1Variable,ps1Boolean,ps1Constant,ps1BuiltIn,@Spell "
]
}
