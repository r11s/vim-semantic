 ["syntax/dosini.vim:26","match  dosiniNumber   \"=\\zs\\s*\\d\\+\\s*$\""],
 ["syntax/dosini.vim:27","match  dosiniNumber   \"=\\zs\\s*\\d*\\.\\d\\+\\s*$\""],
 ["syntax/dosini.vim:28","match  dosiniNumber   \"=\\zs\\s*\\d\\+e[+-]\\=\\d\\+\\s*$\""],
 ["syntax/dosini.vim:29","region dosiniHeader   start=\"^\\s*\\[\" end=\"\\]\""],
 ["syntax/dosini.vim:30","match  dosiniComment  \"^[#;].*$\" contains=@Spell"],
 ["syntax/dosini.vim:31","region dosiniSection  start=\"\\s*\\[.*\\]\" end=\"\\ze\\s*\\[.*\\]\" fold contains=dosiniLabel,dosiniValue,dosiniNumber,dosiniHeader,dosiniComment"],
