 "dosiniNumber   xxx match /=\\zs\\s*\\d\\+\\s*$/  ",
 "                   match /=\\zs\\s*\\d*\\.\\d\\+\\s*$/  ",
 "                   match /=\\zs\\s*\\d\\+e[+-]\\=\\d\\+\\s*$/  ",
