 "rAssign        xxx match /=/  ",
 "                   match /<\\{1,2}-/  ",
 "                   match /->\\{1,2}/  ",
 "                   links to Statement",
 "rOperator      xxx match /&/  ",
 "                   match /-/  ",
 "                   match /\\*/  ",
 "                   match /+/  ",
 "                   match +[|!<>^~/:]+  ",
 "                   match /%\\{2}\\|%\\S\\{-}%/  ",
 "                   match /\\([!><]\\)\\@<==/  ",
 "                   match /==/  ",
 "                   match /|>/  ",
 "                   links to Operator",
 "rOpError       xxx match /\\*\\{3}/  ",
 "                   match +//+  ",
 "                   match /&&&/  ",
 "                   match /|||/  ",
 "                   match /<</  ",
 "                   match />>/  ",
 "                   links to Error",
 "rDelimiter     xxx match /[,;:]/  ",
 "                   links to Delimiter",
 "rParenError    xxx match /[\\]}]/  contained ",
 "                   links to Error",
 "rRegion        xxx matchgroup=Delimiter start=/(/ end=/)/  transparent contains=ALLBUT,rError,rBraceError,rCurlyError ",
 "                   matchgroup=Delimiter start=/{/ end=/}/  transparent contains=ALLBUT,rError,rBraceError,rParenError ",
 "                   matchgroup=Delimiter start=/\\[/ end=/]/  transparent contains=ALLBUT,rError,rCurlyError,rParenError ",
 "rFunction      xxx match /[0-9a-zA-Z_\\.]\\+\\s*\\ze(/  ",
 "                   links to Function",
 "rDollar        xxx match /\\$/  display contained ",
 "                   match /@/  display contained ",
 "                   links to SpecialChar",
 "rLstElmt       xxx match /\\$[a-zA-Z0-9\\\\._]*/  contains=rDollar ",
 "                   match /@[a-zA-Z0-9\\\\._]*/  contains=rDollar ",
 "                   links to Normal",
 "rPreProc       xxx detach library require source attach",
 "                   links to PreProc",
 "rType          xxx vector list double logical category complex data.frame array",
 "                   function integer matrix character numeric",
 "                   match /\\\\/  ",
 "                   links to Type",
 "rNameWSpace    xxx start=/`/ end=/`/  contains=rSpaceFun ",
 "                   links to Normal",
 "Spell          cluster=NONE"
]
}
