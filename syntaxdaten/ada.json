 "                   match /\\<use\\>/  contained contains=NONE ",
 "                   links to Include",
 "adaBeginWith   xxx match /^\\s*\\zs\\(\\(with\\(\\s\\+type\\)\\=\\)\\|\\(use\\)\\)\\>/  contains=adaInc ",
 "adaSemiWith    xxx match /;\\s*\\zs\\(\\(with\\(\\s\\+type\\)\\=\\)\\|\\(use\\)\\)\\>/  contains=adaInc ",
 "adaString      xxx start=/\"/ skip=/\"\"/ end=/\"/  contains=@Spell ",
 "                   links to String",
 "adaCharacter   xxx match /'.'/  ",
 "                   links to Character",
 "adaTodo        xxx contained todo xxx fixme note",
 "                   links to Todo",
 "adaComment     xxx start=/--/ end=/$/  oneline contains=adaTodo,adaLineError,@Spell ",
 "                   links to Comment",
 "Spell          cluster=NONE"
]
}
