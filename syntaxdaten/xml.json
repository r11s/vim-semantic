"liste": [
 "--- Syntax items ---",
 "xmlError       xxx match /</  ",
 "                   match /&/  ",
 "                   links to Error",
 "xmlEntity      xxx match /&[^; \\t]*;/  contains=xmlEntityPunct ",
 "                   links to Statement",
 "xmlString      xxx start=/\"/ end=/\"/  display contained contains=xmlEntity,@Spell ",
 "                   start=/'/ end=/'/  display contained contains=xmlEntity,@Spell ",
 "                   links to String",
 "xmlAttribPunct xxx match /[:.]/  display contained ",
 "                   links to Comment",
 "xmlEqual       xxx match /=/  display ",
 "xmlAttrib      xxx match +\\%#=1[-/!?<>\"']\\@1<!\\<[a-zA-Z:_][-.0-9a-zA-Z:_]*\\>['\"]\\@!+  display contained contains=xmlAttribPunct,@xmlAttribHook ",
 "                   links to Type",
 "xmlNamespace   xxx match =<[^ /!?<>\"':]\\+\\ze:=ms=s+1,lc=1  display contained contains=@xmlNamespaceHook ",
 "                   match =</[^ /!?<>\"':]\\+\\ze:=ms=s+2,lc=2  display contained contains=@xmlNamespaceHook ",
 "                   links to Tag",
 "xmlTagName     xxx match =<[^ /!?<>\"']\\+=ms=s+1,lc=1  display contained contains=xmlNamespace,xmlAttribPunct,@xmlTagHook ",
 "                   match =</[^ /!?<>\"']\\+=ms=s+2,lc=2  display contained contains=xmlNamespace,xmlAttribPunct,@xmlTagHook ",
 "                   links to Function",
 "xmlTag         xxx matchgroup=xmlTag start=+<\\ze[^ /!?<>\"']+ end=/>/  contains=xmlError,xmlTagName,xmlAttrib,xmlEqual,xmlString,@xmlStartTagHook ",
 "                   links to Function",
 "xmlEndTag      xxx matchgroup=xmlTag start=+</\\ze[^ /!?<>\"']+ end=/>/  contains=xmlTagName,xmlNamespace,xmlAttribPunct,@xmlTagHook ",
 "                   links to Identifier",
 "xmlCdata       xxx start=/<!\\[CDATA\\[/ end=/]]>/  keepend extend contains=xmlCdataStart,xmlCdataEnd,@xmlCdataHook,@Spell ",
 "                   links to String",
 "xmlComment     xxx start=/<!/ end=/>/  extend contains=xmlCommentStart,xmlCommentError ",
 "                   links to Comment",
 "xmlProcessing  xxx matchgroup=xmlProcessingDelim start=/<?/ end=/?>/  contains=xmlAttrib,xmlEqual,xmlString ",
 "                   links to Type",
 "xmlEntityPunct xxx match /[&.;]/  contained ",
 "                   links to Type",
 "xmlCommentStart xxx match /<!/  contained nextgroup=xmlCommentPart ",
 "                   links to xmlComment",
 "xmlCommentError xxx match /[^><!]/  contained ",
 "                   links to Error",
 "xmlCommentPart xxx start=/--/ end=/--/  contained contains=xmlTodo,@xmlCommentHook,@Spell ",
 "                   links to Comment",
 "xmlTodo        xxx contained XXX FIXME TODO",
 "                   links to Todo",
 "xmlCdataStart  xxx match /<!\\[CDATA\\[/  contained contains=xmlCdataCdata ",
 "                   links to Type",
 "xmlCdataEnd    xxx match /]]>/  contained ",
 "                   links to Type",
 "xmlCdataCdata  xxx contained CDATA",
 "                   links to Statement",
 "xmlDocTypeKeyword xxx contained SYSTEM PUBLIC DOCTYPE",
 "                   links to Statement",
 "xmlInlineDTD   xxx matchgroup=xmlDocTypeDecl start=/\\[/ end=/]/  contained contains=@xmlDTD ",
 "                   links to Function",
 "xmlDocType     xxx matchgroup=xmlDocTypeDecl start=/<!DOCTYPE/he=s+2,rs=s+2 end=/>/  contains=xmlDocTypeKeyword,xmlInlineDTD,xmlString ",
 "dtdTag         xxx matchgroup=dtdFunction start=/<!/ end=/>/  contained contains=dtdTag,dtdTagName,dtdError,dtdComment,dtdString,dtdAttrType,dtdAttrDef,dtdEnum,dtdParamEntityInst,dtdParamEntityDecl,dtdCard,@dtdTagHook ",
 "                   links to Normal",
 "dtdTagName     xxx match /<!\\(ATTLIST\\|DOCTYPE\\|ELEMENT\\|ENTITY\\|NOTATION\\|SHORTREF\\|USEMAP\\|\\[\\)/ms=s+2,hs=s+2,lc=2  contained ",
 "                   links to Statement",
 "dtdError       xxx start=/<!/ms=s+2,lc=2 end=/>/  contained ",
 "                   links to Error",
 "dtdComment     xxx start=/<![ \\t]*--/ end=/-->/  contained contains=dtdTodo,@Spell ",
 "                   start=/--/ end=/--/  contained contains=dtdTodo,@Spell ",
 "                   links to Comment",
 "dtdString      xxx start=/\"/ skip=/\\\\\\\\\\|\\\\\"/ end=/\"/  contained contains=dtdAttrDef,dtdAttrType,dtdParamEntityInst,dtdEntity,dtdCard ",
 "                   start=/'/ skip=/\\\\\\\\\\|\\\\'/ end=/'/  contained contains=dtdAttrDef,dtdAttrType,dtdParamEntityInst,dtdEntity,dtdCard ",
 "                   links to dtdConstant",
 "dtdAttrType    xxx contained NMTOKEN ID NMTOKENS IDREFS CDATA IDREF ENTITIES",
 "                   match /[^!]\\<ENTITY/  contained ",
 "                   links to dtdType",
 "dtdAttrDef     xxx match /#REQUIRED/  contained ",
 "                   match /#IMPLIED/  contained ",
 "                   match /#FIXED/  contained ",
 "                   links to dtdType",
 "dtdEnum        xxx matchgroup=dtdType start=/(/ end=/)/  contained contains=dtdEnum,dtdParamEntityInst,dtdCard,@dtdEnumHook ",
 "                   links to dtdConstant",
 "dtdParamEntityInst xxx matchgroup=dtdParamEntityPunct start=/%[-_a-zA-Z0-9.]\\+/he=s+1,rs=s+1 skip=/[-_a-zA-Z0-9.]/ end=/;\\|\\>/  contained oneline contains=dtdParamEntityPunct ",
 "                   links to dtdConstant",
 "dtdParamEntityDecl xxx match /<!ENTITY % [-_a-zA-Z0-9.]*/ms=s+8,lc=8  contained contains=dtdParamEntityDPunct ",
 "                   links to dtdType",
 "dtdCard        xxx match /|/  contained ",
 "                   match /,/  contained ",
 "                   match /&/  contained ",
 "                   match /?/  contained ",
 "                   match /\\*/  contained ",
 "                   match /+/  contained ",
 "                   match /ANY/  contained ",
 "                   match /EMPTY/  contained ",
 "                   links to dtdFunction",
 "dtdTodo        xxx contained XXX FIXME TODO",
 "                   links to Todo",
 "dtdParamEntityPunct xxx match /\\./  contained ",
 "                   links to dtdType",
 "dtdParamEntityDPunct xxx match /%\\|\\./  contained ",
 "                   links to dtdComment",
 "dtdEntityPunct xxx match /[&.;]/  contained ",
 "                   links to dtdType",
 "dtdEntity      xxx match /&[^; \\t]*;/  contained contains=dtdEntityPunct ",
 "                   links to Statement",
 "Spell          cluster=NONE",
 "xmlAttribHook  cluster=NONE",
 "xmlNamespaceHook cluster=NONE",
 "xmlTagHook     cluster=NONE",
 "xmlStartTagHook cluster=NONE",
 "xmlCommentHook cluster=NONE",
 "xmlCdataHook   cluster=NONE",
 "xmlDTD         cluster=dtdTag,dtdComment,dtdString,dtdAttrType,dtdAttrDef,dtdEnum,dtdParamEntityInst,dtdParamEntityDecl,dtdCard,dtdEntity ",
 "dtdTagHook     cluster=NONE",
 "dtdEnumHook    cluster=NONE"
]
