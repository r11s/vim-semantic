"liste": [
 "--- Syntax items ---",
 "scilabStatement xxx clear mode exit clearglobal quit end return abort global",
 "                   predef resume",
 "                   links to Statement",
 "scilabFunction xxx funptr function endfunction",
 "                   links to Keyword",
 "scilabPredicate xxx isglobal null iserror",
 "                   links to Keyword",
 "scilabKeyword  xxx typename",
 "                   links to Keyword",
 "scilabDebug    xxx who debug whereami where what pause whos whereis",
 "                   links to Debug",
 "scilabRepeat   xxx while for break",
 "                   links to Repeat",
 "scilabConditional xxx else if elseif then",
 "                   links to Conditional",
 "scilabMultiplex xxx select case",
 "                   links to Conditional",
 "scilabConstant xxx match /\\(%\\)[0-9A-Za-z?!#$]\\+/  ",
 "                   links to Constant",
 "scilabBoolean  xxx match /\\(%\\)[FTft]\\>/  ",
 "                   links to Boolean",
 "scilabDelimiter xxx match /[][;,()]/  ",
 "                   links to Delimiter",
 "scilabComparison xxx match /[=~]=/  ",
 "                   match /[<>]=\\=/  ",
 "                   match /<>/  ",
 "                   links to Operator",
 "scilabLogical  xxx match /[&|~]/  ",
 "                   links to Operator",
 "scilabAssignment xxx match /=/  ",
 "                   links to Operator",
 "scilabArithmetic xxx match /[+-]/  ",
 "                   match +\\.\\=[*/\\\\]\\.\\=+  ",
 "                   match /\\.\\=^/  ",
 "                   links to Operator",
 "scilabRange    xxx match /:/  ",
 "                   links to Operator",
 "scilabMlistAccess xxx match /\\./  ",
 "                   links to Delimiter",
 "scilabLineContinuation xxx match /\\.\\{2,}/  ",
 "                   links to Underlined",
 "scilabTransposition xxx match /[])a-zA-Z0-9?!_#$.]'/ms=s+1,lc=1  ",
 "                   links to Operator",
 "scilabTodo     xxx contained TODO fixme FIXME TBD tbd todo",
 "                   links to Todo",
 "scilabComment  xxx match +//.*$+  contains=scilabTodo ",
 "                   links to Comment",
 "scilabNumber   xxx match /[0-9]\\+\\(\\.[0-9]*\\)\\=\\([DEde][+-]\\=[0-9]\\+\\)\\=/  ",
 "                   match /\\.[0-9]\\+\\([DEde][+-]\\=[0-9]\\+\\)\\=/  ",
 "                   links to Number",
 "scilabString   xxx start=/'/ skip=/''/ end=/'/  oneline ",
 "                   start=/\"/ end=/\"/  oneline ",
 "                   links to String",
 "scilabIdentifier xxx match /\\<[A-Za-z?!_#$][A-Za-z0-9?!_#$]*\\>/  ",
 "                   links to Identifier",
 "scilabOverload xxx match /%[A-Za-z0-9?!_#$]\\+_[A-Za-z0-9?!_#$]\\+/  ",
 "                   links to Special"
]
