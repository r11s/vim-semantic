"liste": [
 "--- Syntax items ---",
 "ucError        xxx match /[\\\\@`]/  ",
 "                   match +<<<\\|\\.\\.\\|=>\\|<>\\|||=\\|&&=\\|[^-]->\\|\\*\\/+  ",
 "                   links to Error",
 "ucBranch       xxx continue break",
 "                   links to Conditional",
 "ucConditional  xxx else switch if",
 "                   links to Conditional",
 "ucRepeat       xxx foreach for while do",
 "                   links to Repeat",
 "ucBoolean      xxx true false",
 "                   links to Boolean",
 "ucConstant     xxx null",
 "                   links to ucBoolean",
 "ucOperator     xxx new instanceof",
 "                   links to Operator",
 "ucType         xxx vector float name boolean elighttype long local",
 "                   defaultproperties noexport ipaddr void pawn sound ammo",
 "                   string bool native double short char actor function out var",
 "                   state byte int auto exec event",
 "                   links to Type",
 "ucStatement    xxx return",
 "                   links to Statement",
 "ucStorageClass xxx transient synchronized static final volatile",
 "                   links to StorageClass",
 "ucMethodDecl   xxx synchronized throws",
 "                   links to ucStorageClass",
 "ucSpecial      xxx match /\\\\u\\d\\{4\\}/  ",
 "                   links to Special",
 "ucSpecialChar  xxx match /\\\\\\([4-9]\\d\\|[0-3]\\d\\d\\|[\\\"\\\\'ntbrf]\\|u\\x\\{4\\}\\)/  contained ",
 "                   links to SpecialChar",
 "ucClassKeys    xxx class expands extends",
 "                   links to Conditional",
 "ucClassDecl    xxx match /^[Cc]lass[\\s$]*\\S*[\\s$]*expands[\\s$]*\\S*;/  contains=ucSpecial,ucSpecialChar,ucClassKeys ",
 "                   links to ucStorageClass",
 "ucCommentString xxx start=/\"/ end=+\\*/+me=s-1,he=s-1 end=/\"/  contained contains=ucSpecial,ucCommentStar,ucSpecialChar ",
 "                   links to ucString",
 "ucNumber       xxx match /\\<\\(0[0-7]*\\|0[xX]\\x\\+\\|\\d\\+\\)[lL]\\=\\>/  ",
 "                   match /\\(\\<\\d\\+\\.\\d*\\|\\.\\d\\+\\)\\([eE][-+]\\=\\d\\+\\)\\=[fFdD]\\=/  ",
 "                   match /\\<\\d\\+[eE][-+]\\=\\d\\+[fFdD]\\=\\>/  ",
 "                   match /\\<\\d\\+\\([eE][-+]\\=\\d\\+\\)\\=[fFdD]\\>/  ",
 "                   links to Number",
 "ucExternal     xxx match /^\\#exec.*/  contains=ucCommentString,ucNumber ",
 "                   links to Include",
 "ucScopeDecl    xxx protected private public abstract",
 "                   links to ucStorageClass",
 "ucFuncDef      xxx match /^.*function\\s*[\\(]*/  contains=ucType,ucStorageClass ",
 "                   links to Conditional",
 "ucEventDef     xxx match /^.*event\\s*[\\(]*/  contains=ucType,ucStorageClass ",
 "                   links to Conditional",
 "ucCharacter    xxx match /'[^']*'/  contains=ucSpecialChar,ucSpecialCharError ",
 "                   match /'\\\\''/  contains=ucSpecialChar ",
 "                   match /'[^\\\\]'/  ",
 "                   links to Character",
 "ucClassLabel   xxx match /[a-zA-Z0-9]*\\'[a-zA-Z0-9]*\\'/  contains=ucCharacter ",
 "                   links to Conditional",
 "ucLabel        xxx default",
 "                   links to Label",
 "ucLabelRegion  xxx matchgroup=ucLabel start=/\\<case\\>/ matchgroup=NONE end=/:/  transparent contains=ucNumber ",
 "ucUserLabel    xxx match /^\\s*[_$a-zA-Z][_$a-zA-Z0-9_]*\\s*:/he=e-1  contains=ucLabel ",
 "                   links to Label",
 "ucTodo         xxx contained todo xxx fixme",
 "                   links to Todo",
 "ucCommentStar  xxx match +^\\s*\\*[^/]+me=e-1  contained ",
 "                   match /^\\s*\\*$/  contained ",
 "                   links to ucComment",
 "ucComment2String xxx start=/\"/ end=/$\\|\"/  contained contains=ucSpecial,ucSpecialChar ",
