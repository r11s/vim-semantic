"liste": [
 "--- Syntax items ---",
 "tomlEscape     xxx match +\\\\[betnfr\"/\\\\]+  display contained ",
 "                   match /\\\\x\\x\\{2}/  contained ",
 "                   match /\\\\u\\x\\{4}/  contained ",
 "                   match /\\\\U\\x\\{8}/  contained ",
 "                   links to SpecialChar",
 "tomlLineEscape xxx match /\\\\$/  contained ",
 "                   links to SpecialChar",
 "tomlString     xxx start=/\"/ skip=/\\\\\\\\\\|\\\\\"/ end=/\"/  oneline contains=tomlEscape ",
 "                   start=/\"\"\"/ end=/\"\"\"/  contains=tomlEscape,tomlLineEscape ",
 "                   start=/'/ end=/'/  oneline ",
 "                   start=/'''/ end=/'''/  ",
 "                   links to String",
 "tomlInteger    xxx match /[+-]\\=[1-9]\\(_\\=\\d\\)*/  display ",
 "                   match /[+-]\\=0/  display ",
 "                   match /[+-]\\=0x[[:xdigit:]]\\(_\\=[[:xdigit:]]\\)*/  display ",
 "                   match /[+-]\\=0o[0-7]\\(_\\=[0-7]\\)*/  display ",
 "                   match /[+-]\\=0b[01]\\(_\\=[01]\\)*/  display ",
 "                   match /[+-]\\=\\(inf\\|nan\\)/  display ",
 "                   links to Number",
 "tomlFloat      xxx match /[+-]\\=\\d\\(_\\=\\d\\)*\\.\\d\\+/  display ",
 "                   match /[+-]\\=\\d\\(_\\=\\d\\)*\\(\\.\\d\\(_\\=\\d\\)*\\)\\=[eE][+-]\\=\\d\\(_\\=\\d\\)*/  display ",
 "                   links to Float",
 "tomlBoolean    xxx match /\\<\\%(true\\|false\\)\\>/  display ",
 "                   links to Boolean",
 "tomlDate       xxx match /\\d\\{4\\}-\\d\\{2\\}-\\d\\{2\\}/  display ",
 "                   match /\\d\\{2\\}:\\d\\{2\\}\\%(:\\d\\{2\\}\\%(\\.\\d\\+\\)\\?\\)\\?/  display ",
 "                   match /\\d\\{4\\}-\\d\\{2\\}-\\d\\{2\\}[Tt ]\\d\\{2\\}:\\d\\{2\\}\\%(:\\d\\{2\\}\\%(\\.\\d\\+\\)\\?\\)\\?\\%([Zz]\\|[+-]\\d\\{2\\}:\\d\\{2\\}\\)\\?/  display ",
 "                   links to Constant",
 "tomlDotInKey   xxx match /\\v[^.]+\\zs\\./  display contained ",
 "                   links to Normal",
 "tomlKey        xxx match /\\v(^|[{,])\\s*\\zs[[:alnum:]._-]+\\ze\\s*\\=/  display contains=tomlDotInKey ",
 "                   links to Identifier",
 "tomlKeyDq      xxx start=/\\v(^|[{,])\\s*\\zs\"/ end=/\"\\ze\\s*=/  oneline contains=tomlEscape ",
 "                   links to Identifier",
 "tomlKeySq      xxx start=/\\v(^|[{,])\\s*\\zs'/ end=/'\\ze\\s*=/  oneline ",
 "                   links to Identifier",
 "tomlTable      xxx start=/^\\s*\\[[^\\[]/ end=/\\]/  oneline contains=tomlKey,tomlKeyDq,tomlKeySq,tomlDotInKey ",
 "                   links to Title",
 "tomlTableArray xxx start=/^\\s*\\[\\[/ end=/\\]\\]/  oneline contains=tomlKey,tomlKeyDq,tomlKeySq,tomlDotInKey ",
 "                   links to Title",
 "tomlKeyValueArray xxx start=/=\\s*\\[\\zs/ end=/\\]/  contains=@tomlValue ",
 "tomlArray      xxx start=/\\[/ end=/\\]/  contained contains=@tomlValue ",
 "tomlComment    xxx match /#.*/  contains=@Spell,tomlTodo ",
 "                   links to Comment",
 "tomlTodo       xxx contained BUG XXX FIXME TODO",
 "                   links to Todo",
 "tomlValue      cluster=tomlArray,tomlString,tomlInteger,tomlFloat,tomlBoolean,tomlDate,tomlComment ",
 "Spell          cluster=NONE"
]
