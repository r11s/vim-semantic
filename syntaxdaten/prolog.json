"liste": [
 "--- Syntax items ---",
 "prologCComment xxx start=+/\\*+ end=+\\*/+  contains=@Spell ",
 "                   links to Comment",
 "prologComment  xxx match /%.*/  contains=@Spell ",
 "                   links to Comment",
 "prologKeyword  xxx atom_concat atom get_byte halt float asserta number_chars",
 "                   writeq write current_prolog_flag read current_output",
 "                   current_input peek_byte assertz atom_length set_prolog_flag",
 "                   set_output current_char_conversion abolish multifile clause",
 "                   op bagof throw set_stream_position flush_output",
 "                   unify_with_occurs_check close true write_canonical",
 "                   current_predicate stream_property compound copy_term number",
 "                   char_code atomic repeat catch append functor read_term",
 "                   current_op put_char arg fail retract put_code set_input",
 "                   dynamic atom_codes integer nonvar setof char_conversion var",
 "                   once at_end_of_stream number_codes meta_predicate open",
 "                   write_term get_char nl put_byte findall is get_code",
 "                   peek_char module sub_atom call peek_code atom_chars",
 "                   links to Keyword",
 "prologCharCode xxx match /0'\\\\\\=./  ",
 "                   links to Special",
 "prologString   xxx start=/\"/ skip=/\\\\\\\\\\|\\\\\"/ end=/\"/  contains=@Spell ",
 "                   links to String",
 "prologAtom     xxx start=/'/ skip=/\\\\\\\\\\|\\\\'/ end=/'/  ",
 "                   links to String",
 "prologClause   xxx matchgroup=prologClauseHead start=/^\\s*[a-z]\\w*/ matchgroup=Normal end=/\\.\\s\\|\\.$/  contains=ALLBUT,prologClause ",
 "                   links to Normal",
 "prologOperator xxx match /=\\\\=\\|=:=\\|\\\\==\\|=<\\|==\\|>=\\|\\\\=\\|\\\\+\\|=\\.\\.\\|<\\|>\\|=/  ",
 "                   links to Operator",
 "prologAsIs     xxx match /===\\|\\\\===\\|<=\\|=>/  ",
 "                   links to Normal",
 "prologNumber   xxx match /\\<\\d*\\>'\\@!/  ",
 "                   match /\\<0[xX]\\x*\\>'\\@!/  ",
 "                   links to Number",
 "prologCommentError xxx match +\\*/+  ",
 "                   links to Error",
 "prologSpecialCharacter xxx match /;/  ",
 "                   match /!/  ",
 "                   match /:-/  ",
 "                   match /-->/  ",
 "                   links to Special",
 "prologQuestion xxx match /?-.*\\./  contains=prologNumber ",
 "                   links to PreProc",
 "Spell          cluster=NONE",
 "NoSpell        cluster=NONE"
]
