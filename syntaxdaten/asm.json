 "                   match /\\.short/  ",
 "                   match /\\.single/  ",
 "                   match /\\.space/  ",
 "                   match /\\.string/  ",
 "                   match /\\.word/  ",
 "                   match /\\.2byte/  ",
 "                   match /\\.4byte/  ",
 "                   match /\\.8byte/  ",
 "                   links to Type",
 "asmIdentifier  xxx match /[a-z_][a-z0-9_]*/  ",
 "                   links to Identifier",
 "asmLabel       xxx match /[a-z_][a-z0-9_]*:/he=e-1  ",
 "                   links to Label",
 "asmDecimal     xxx match /\\<0\\+[1-7]\\=\\>/  display ",
 "                   match /\\<[1-9]\\d*\\>/  display ",
 "                   links to Number",
 "asmOctal       xxx match /\\<0[0-7][0-7]\\+\\>/  display ",
 "                   links to Number",
 "asmHexadecimal xxx match /\\<0[xX][0-9a-fA-F]\\+\\>/  display ",
 "                   links to Number",
 "asmBinary      xxx match /\\<0[bB][0-1]\\+\\>/  display ",
 "                   links to Number",
 "asmFloat       xxx match /\\<\\d\\+\\.\\d*\\%(e[+-]\\=\\d\\+\\)\\=\\>/  display ",
 "                   match /\\.\\d\\+\\%(e[+-]\\=\\d\\+\\)\\=\\>/  display ",
 "                   match /\\<\\d\\%(e[+-]\\=\\d\\+\\)\\>/  display ",
 "                   match /[+-]\\=Inf\\>\\|\\<NaN\\>/  display ",
 "                   match /\\%(0[edfghprs]\\)[+-]\\=\\d*\\%(\\.\\d\\+\\)\\%(e[+-]\\=\\d\\+\\)\\=/  display ",
 "                   match /\\%(0[edfghprs]\\)[+-]\\=\\d\\+\\%(\\.\\d\\+\\)\\=\\%(e[+-]\\=\\d\\+\\)\\=/  display ",
 "                   match /\\%(0x\\)[+-]\\=\\d*\\%(\\.\\d\\+\\)\\%(e[+-]\\=\\d\\+\\)\\=/  display ",
 "                   links to Float",
 "asmCharacterEscape xxx match /\\\\./  contained ",
 "                   links to Special",
 "asmCharacter   xxx match /'\\\\\\=./  contains=asmCharacterEscape ",
