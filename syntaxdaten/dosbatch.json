 "--- Syntax items ---",
 "dosbatchTodo   xxx contained todo",
 "                   links to Todo",
 "dosbatchStatement xxx goto exit call",
 "                   links to Statement",
 "dosbatchConditional xxx else if",
 "                   links to Conditional",
 "dosbatchRepeat xxx for",
 "                   links to Repeat",
 "dosbatchOperator xxx GTR LEQ EQU NEQ GEQ LSS",
 "                   match =\\s[-+\\*/%!~]\\s=  ",
 "                   match /=/  ",
 "                   match #[-+\\*/%]=#  ",
 "                   match /\\s\\(&\\||\\|^\\|<<\\|>>\\)=\\=\\s/  ",
 "                   links to Operator",
 "dosbatchIfOperator xxx match /if\\s\\+\\(\\(not\\)\\=\\s\\+\\)\\=\\(exist\\|defined\\|errorlevel\\|cmdextversion\\)\\=/ms=s+2,lc=2  ",
 "                   links to dosbatchOperator",
 "dosbatchVariable xxx match /%\\h\\w*%/  ",
 "                   match /%\\h\\w*:\\*\\=[^=]*=[^%]*%/  ",
 "                   match /%\\h\\w*:\\~[-]\\=\\d\\+\\(,[-]\\=\\d\\+\\)\\=%/  contains=dosbatchInteger ",
 "                   match /!\\h\\w*!/  ",
 "                   match /!\\h\\w*:\\*\\=[^=]*=[^!]*!/  ",
 "                   match /!\\h\\w*:\\~[-]\\=\\d\\+\\(,[-]\\=\\d\\+\\)\\=!/  contains=dosbatchInteger ",
 "                   links to dosbatchIdentifier",
 "dosBatchArgument xxx match /%\\(\\d\\|\\*\\)/  ",
 "                   match /%%[a-z]\\>/  ",
 "                   match /%\\~[fdpnxsatz]\\+\\(\\($PATH:\\)\\=[a-z]\\|\\d\\)\\>/  ",
 "                   links to Identifier",
 "dosbatchSpecialChar xxx match /\\^[&|()<>^]/  ",
 "                   match /\\$[a-hl-npqstv_$+]/  ",
 "                   match /%%/  ",
 "                   links to SpecialChar",
 "dosbatchString xxx match /\\\"[^\"]*\\\"/  contains=dosbatchVariable,dosBatchArgument,dosbatchSpecialChar,@dosbatchNumber,@Spell ",
 "                   match /\\<echo\\([^)>|]\\|\\^\\@<=[)>|]\\)*/ms=s+4,lc=4  contains=dosbatchVariable,dosBatchArgument,dosbatchSpecialChar,@dosbatchNumber,@Spell ",
 "                   links to String",
 "dosbatchEchoOperator xxx match /\\<echo\\s\\+\\(on\\|off\\)\\s*$/ms=s+4,lc=4  ",
 "                   links to dosbatchOperator",
 "dosbatchImplicit xxx tree del sort start color path pushd popd replace shift",
 "                   subst chkdsk print vol doskey findstr type convert more cmd",
 "                   ver echo find keyb chcp compact recover md graftabl diskcomp",
 "                   xcopy help cd rd copy break comp append label assoc rename",
 "                   time chdir verify fc dir diskcopy restore cacls prompt date",
 "                   at attrib setlocal set mode endlocal rmdir pause mkdir ftype",
 "                   move format rem ren title chkntfs cls erase",
 "                   links to Function",
 "dosbatchCmd    xxx match /(\\s*'[^']*'/ms=s+1,lc=1  contains=dosbatchString,dosbatchVariable,dosBatchArgument,@dosbatchNumber,dosbatchImplicit,dosbatchStatement,dosbatchConditional,dosbatchRepeat,dosbatchOperator,dosbatchIfOperator ",
 "                   links to PreProc",
 "dosbatchInteger xxx match #[[:space:]=(/:,!~-]\\d\\+#ms=s+1,lc=1  ",
 "                   links to dosbatchNumber",
 "dosbatchHex    xxx match #[[:space:]=(/:,!~-]0x\\x\\+#ms=s+1,lc=1  ",
 "                   links to dosbatchNumber",
 "dosbatchBinary xxx match #[[:space:]=(/:,!~-]0b[01]\\+#ms=s+1,lc=1  ",
 "                   links to dosbatchNumber",
 "dosbatchOctal  xxx match #[[:space:]=(/:,!~-]0\\o\\+#ms=s+1,lc=1  ",
 "                   links to dosbatchNumber",
 "dosbatchSwitch xxx match =/\\(\\a\\+\\|?\\)=  ",
 "                   links to Special",
 "dosbatchIdentifier xxx match /\\s\\h\\w*\\>/  contained ",
 "                   links to Identifier",
 "dosbatchSet    xxx match /\\s\\h\\w*[+-]\\==\\{-1}/  contains=dosbatchIdentifier,dosbatchOperator ",
 "dosbatchLabel  xxx match /^\\s*:\\s*\\h\\w*\\>/  ",
 "                   match /\\<\\(goto\\|call\\)\\s\\+:\\h\\w*\\>/ms=s+4,lc=4  ",
 "                   match /\\<goto\\s\\+\\h\\w*\\>/ms=s+4,lc=4  ",
 "                   match /:\\h\\w*\\>/  ",
 "                   links to Label",
 "dosbatchRemComment xxx match /^rem\\($\\|\\s.*$\\)/ms=s+3,lc=3  contains=dosbatchTodo,dosbatchSpecialChar,@dosbatchNumber,dosbatchVariable,dosBatchArgument,@Spell ",
 "                   match /^@rem\\($\\|\\s.*$\\)/ms=s+4,lc=4  contains=dosbatchTodo,@dosbatchNumber,dosbatchVariable,dosBatchArgument,@Spell ",
 "                   match /\\srem\\($\\|\\s.*$\\)/ms=s+4,lc=4  contains=dosbatchTodo,dosbatchSpecialChar,@dosbatchNumber,dosbatchVariable,dosBatchArgument,@Spell ",
 "                   match /\\s@rem\\($\\|\\s.*$\\)/ms=s+5,lc=5  contains=dosbatchTodo,@dosbatchNumber,dosbatchVariable,dosBatchArgument,@Spell ",
 "                   links to dosbatchComment",
 "dosbatchColonComment xxx match /\\s*:\\s*:.*$/  contains=dosbatchTodo,dosbatchSpecialChar,@dosbatchNumber,dosbatchVariable,dosBatchArgument,@Spell ",
