    "configuration": {
      "title": "VimSem",
      "properties": {
        "vimsem.logFile": {
          "type": "boolean",
          "default": false,
          "description": "Also write the log for troubleshooting to protokoll.txt in the extension folder"
        },
        "vimsem.backgroundGroups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Todo",
            "Error",
            "Constant"
          ],
          "description": "Vim highlight groups whose background color is shown"
        }
      }
    }
  }
}
